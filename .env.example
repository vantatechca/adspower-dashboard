# ── Cloud server (Render sets these; copy here only for local dev) ──
DATABASE_URL=postgres://user:pass@host:5432/dbname
APP_TOKEN=change-me-ui-token
BRIDGE_TOKEN=change-me-bridge-token

# Optional: enables the Claude AI-parse fallback for weird proxy formats.
# Leave blank to use the deterministic parser only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

PORT=5000
