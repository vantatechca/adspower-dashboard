# ── Local bridge config (copy to .env and fill in) ──
# The cloud service URL from Render (no trailing slash needed).
CLOUD_URL=https://adspower-console.onrender.com
# Must match BRIDGE_TOKEN set on the cloud service (Render → Environment).
BRIDGE_TOKEN=change-me-bridge-token

# Optional: AdsPower Local API endpoint (default shown).
ADSPOWER_API=http://local.adspower.net:50325
# Optional: seconds between polls for new jobs (default 5).
POLL_SECONDS=5
