# Your deployed Render app URL (no trailing slash)
CLOUD_URL=https://adspower-console.onrender.com

# Must match BRIDGE_TOKEN in the Render service
BRIDGE_TOKEN=change-me-bridge-token

# AdsPower Local API (default is fine)
ADSPOWER_API=http://local.adspower.net:50325

# Seconds between polls
POLL_SECONDS=5
